# このファイルを .env.local にコピーして、値を入れる。.env.local は git に入らない。

# --- 必須 ---
# Postgres の接続先。ローカルは docker-compose.yml の DB。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
# セッションの署名に使う秘密の値。`openssl rand -base64 32` などで作る。
NEXTAUTH_SECRET=""
# GitHub の OAuth App（コールバック: <サイトの URL>/api/auth/callback/github）
GITHUB_ID=""
GITHUB_SECRET=""
# Google の OAuth クライアント（リダイレクト URI: <サイトの URL>/api/auth/callback/google）
GOOGLE_ID=""
GOOGLE_SECRET=""

# --- ローカルで必要 ---
# サイトの URL。Vercel では設定しなくてよい（設定するなら本番だけ）。
NEXTAUTH_URL="http://localhost:1207"

# --- 機能ごとに必要 ---
# 解法記録の画像のアップロード（UploadThing v7）
UPLOADTHING_TOKEN=""
# 定期実行（/api/cron/*）を呼べる人を絞る秘密の値。Vercel では必須。
CRON_SECRET=""

# --- 本番の DB（Neon）でマイグレーションを当てるときだけ ---
# 接続プールを通らない、直接つなぐ URL。あれば Prisma の CLI はこちらを使う。
# DATABASE_URL_UNPOOLED=""

# --- 独自 difficulty の推定（npm run difficulty:estimate）を動かす PC だけ ---
# AtCoder にログインしたブラウザのクッキー REVEL_SESSION の値。サーバーには置かない。
# ATCODER_REVEL_SESSION=""
