// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model User {
  id                        String      @id @default(cuid())
  name                      String?
  email                     String?     @unique
  emailVerified             DateTime?   @map("email_verified")
  image                     String?
  atcoderId                 String?     @map("atcoder_id")
  atcoderIdChangedAt        DateTime?   @map("atcoder_id_changed_at")

  accounts                  Account[]
  sessions                  Session[]
  solutions                 Solution[]
  userTags                  UserTag[]
  problemReviews            ProblemReview[]
  atcoderIdFetches          AtCoderIdFetch[]

  @@map("users")
}

// 連携で新しい AtCoder ID のデータを全部取った記録。次の新しい ID を取れるまでの間を測る
model AtCoderIdFetch {
  id                String      @id @default(cuid())
  userId            String      @map("user_id")
  atcoderAccountId  String      @map("atcoder_account_id")
  createdAt         DateTime    @default(now()) @map("created_at")

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("atcoder_id_fetches")
}

// 提出とレート履歴は、同じ AtCoder ID を何人が連携しても1回分だけ持つ
model AtCoderAccount {
  // AtCoder ID は大文字小文字を区別しないので、小文字にそろえて持つ
  id                        String      @id
  name                      String
  submissionsLastFetchedAt  DateTime?   @map("submissions_last_fetched_at")
  // 全件の取得は裏で続けるので、取得中と失敗をここで持つ
  fetchStartedAt            DateTime?   @map("fetch_started_at")
  fetchFailedAt             DateTime?   @map("fetch_failed_at")
  createdAt                 DateTime    @default(now()) @map("created_at")

  submissions               Submission[]
  pendingSubmissions        PendingSubmission[]
  ratingHistory             UserRatingHistory[]

  @@map("atcoder_accounts")
}

model UserRatingHistory {
  id                String   @id @default(cuid())
  atcoderAccountId  String   @map("atcoder_account_id")
  isRated           Boolean  @map("is_rated")
  place             Int
  oldRating         Int      @map("old_rating")
  newRating         Int      @map("new_rating")
  performance       Int
  innerPerformance  Int      @map("inner_performance")
  contestScreenName String   @map("contest_screen_name")
  contestName       String   @map("contest_name")
  contestNameEn     String   @map("contest_name_en")
  endTime           DateTime @map("end_time")

  atcoderAccount    AtCoderAccount @relation(fields: [atcoderAccountId], references: [id], onDelete: Cascade)

  @@unique([atcoderAccountId, contestScreenName])
  @@map("user_rating_history")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Submission {
  id             Int      @id
  epochSecond    Int      @map("epoch_second")
  problemId      String   @map("problem_id")
  contestId      String   @map("contest_id")
  atcoderAccountId String @map("atcoder_account_id")
  language       String
  point          Float
  length         Int
  result         String
  executionTime  Int?     @map("execution_time")

  atcoderAccount AtCoderAccount @relation(fields: [atcoderAccountId], references: [id], onDelete: Cascade)
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Restrict)

  @@index([atcoderAccountId, epochSecond])
  @@map("submissions")
}

// 問題データにまだない問題への提出。捨てると取り直す範囲から外れて二度と拾えないため、ここに取っておき、問題データが入ったら submissions へ移す
model PendingSubmission {
  id               Int      @id
  epochSecond      Int      @map("epoch_second")
  problemId        String   @map("problem_id")
  contestId        String   @map("contest_id")
  atcoderAccountId String   @map("atcoder_account_id")
  language         String
  point            Float
  length           Int
  result           String
  executionTime    Int?     @map("execution_time")

  atcoderAccount   AtCoderAccount @relation(fields: [atcoderAccountId], references: [id], onDelete: Cascade)

  @@index([atcoderAccountId])
  @@map("pending_submissions")
}

model Contest {
  id                String  @id
  startEpochSecond  Int     @map("start_epoch_second")
  durationSecond    BigInt  @map("duration_second")
  
  problems          ContestProblem[]
  firstProblems     Problem[]        @relation("FirstContest")
  solutions         Solution[]
  
  @@map("contests")
}

model Problem {
  id                  String       @id
  name                String
  difficulty          Int?
  totalSolutionCount  Int          @default(0) @map("total_solution_count")
  firstContestId      String       @map("first_contest_id")
  
  firstContest        Contest      @relation("FirstContest", fields: [firstContestId], references: [id])
  contests            ContestProblem[]
  submissions         Submission[]
  solutions           Solution[]
  problemTags         ProblemTag[]
  reviews             ProblemReview[]

  @@map("problems")
}

model ContestProblem {
  contestId     String  @map("contest_id")
  problemId     String  @map("problem_id")
  problemIndex  String  @map("problem_index")

  contest       Contest @relation(fields: [contestId], references: [id])
  problem       Problem @relation(fields: [problemId], references: [id])

  @@id([contestId, problemId])
  @@map("contest_problems")
}

enum SolutionStatus {
  UNSET
  TRYING
  EXPLANATION_AC
  SELF_AC
  REVIEW_AC
  UNSOLVED
}

model Solution {
  id        String          @id @default(cuid())
  userId    String?         @map("user_id")
  problemId String          @map("problem_id")
  contestId String          @map("contest_id")
  title     String?         @db.VarChar(120)
  content   String?         @db.Text
  status    SolutionStatus  @default(UNSET)
  solvedAt  DateTime?       @map("solved_at")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  userTags  SolutionUserTag[]

  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem         @relation(fields: [problemId], references: [id], onDelete: Restrict)
  contest   Contest         @relation(fields: [contestId], references: [id], onDelete: Restrict)
  
  @@index([userId])
  @@index([problemId])
  @@index([contestId])
  @@index([userId, contestId, problemId])
  @@map("solutions")
}

model ProblemReview {
  id             String    @id @default(cuid())
  userId         String?   @map("user_id")
  problemId      String    @map("problem_id")
  stars          Int       @default(3)
  reviewPriority Int       @default(3) @map("review_priority")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // ★はおすすめの問題に使う全員の平均に入るため、アカウントを削除しても誰のものかを外して残す
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  problem        Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
  @@map("problem_reviews")
}

model Tag {
  id            String          @id @default(nanoid())
  name          String          @unique
  createdAt     DateTime        @default(now()) @map("created_at")
  
  userTags      UserTag[]
  problemTags   ProblemTag[]

  @@map("tags")
}

model UserTag {
  id            String         @id @default(nanoid())
  createdById   String         @map("created_by_id")
  tagId         String?        @map("tag_id")
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")

  creator       User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  parentTag     Tag?           @relation(fields: [tagId], references: [id], onDelete: SetNull)
  solutions     SolutionUserTag[]

  @@unique([createdById, name])
  @@unique([createdById, tagId])
  @@map("user_tags")
}

model SolutionUserTag {
  solutionId String @map("solution_id")
  userTagId  String @map("user_tag_id")
  
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  userTag    UserTag  @relation(fields: [userTagId], references: [id], onDelete: Cascade)

  @@id([solutionId, userTagId])
  @@map("solution_user_tags")
}

model ProblemTag {
  problemId String   @map("problem_id")
  tagId     String   @map("tag_id")
  count     Int      @default(0)
  
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
  @@map("problem_tags")
}
